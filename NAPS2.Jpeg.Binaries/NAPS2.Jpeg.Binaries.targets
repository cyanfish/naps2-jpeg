<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

    <ItemGroup>
        <Content Include="$(MSBuildThisFileDirectory)\..\contentFiles\_macarm\libnaps2_jpeg.dylib"
                 Condition="$(RuntimeIdentifier) == 'osx-arm64' or (!$(TargetFramework.StartsWith('net4')) and $(RuntimeIdentifier) == '')">
            <Link>_macarm/libnaps2_jpeg.dylib</Link>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
        <Content Include="$(MSBuildThisFileDirectory)\..\contentFiles\_mac\libnaps2_jpeg.dylib"
                 Condition="$(RuntimeIdentifier) == 'osx-x64' or (!$(TargetFramework.StartsWith('net4')) and $(RuntimeIdentifier) == '')">
            <Link>_mac/libnaps2_jpeg.dylib</Link>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
        <Content Include="$(MSBuildThisFileDirectory)\..\contentFiles\_linux\libnaps2_jpeg.so"
                 Condition="$(RuntimeIdentifier) == 'linux-x64' or (!$(TargetFramework.StartsWith('net4')) and !$(TargetFramework.Contains('macos')) and $(RuntimeIdentifier) == '')">
            <Link>_linux/libnaps2_jpeg.so</Link>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
        <Content Include="$(MSBuildThisFileDirectory)\..\contentFiles\_linuxarm\libnaps2_jpeg.so"
                 Condition="$(RuntimeIdentifier) == 'linux-arm64' or (!$(TargetFramework.StartsWith('net4')) and !$(TargetFramework.Contains('macos')) and $(RuntimeIdentifier) == '')">
            <Link>_linuxarm/libnaps2_jpeg.so</Link>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
        <Content Include="$(MSBuildThisFileDirectory)\..\contentFiles\_win64\naps2_jpeg.dll"
                 Condition="$(RuntimeIdentifier) == 'win-x64' or $(TargetFramework.StartsWith('net4')) or ($(RuntimeIdentifier) == '' and !$(TargetFramework.Contains('macos')))">
            <Link>_win64/naps2_jpeg.dll</Link>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
        <Content Include="$(MSBuildThisFileDirectory)\..\contentFiles\_win32\naps2_jpeg.dll"
                 Condition="$(RuntimeIdentifier) == 'win-x86' or $(TargetFramework.StartsWith('net4')) or ($(RuntimeIdentifier) == '' and !$(TargetFramework.Contains('macos')))">
            <Link>_win32/naps2_jpeg.dll</Link>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
        <Content Include="$(MSBuildThisFileDirectory)\..\contentFiles\_winarm\naps2_jpeg.dll"
                 Condition="$(RuntimeIdentifier) == 'win-arm64' or $(TargetFramework.StartsWith('net4')) or ($(RuntimeIdentifier) == '' and !$(TargetFramework.Contains('macos')))">
            <Link>_winarm/naps2_jpeg.dll</Link>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
    </ItemGroup>

</Project>
